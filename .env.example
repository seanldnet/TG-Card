# Application
APP_ENV=production
PORT=38647
DATA_DIR=./data
WEB_DIST_DIR=./web/dist

# Database: postgres or sqlite
DB_DRIVER=postgres
DATABASE_URL=postgres://tgcard:change-this-password@127.0.0.1:5432/tgcard?sslmode=disable

# First startup only: if ADMIN_PASSWORD is empty, a strong one-time password is generated and printed to server logs.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=use-at-least-12-characters

# Optional. If omitted, a persistent random key is created in DATA_DIR/jwt-secret.
# JWT_SECRET=replace-with-at-least-32-random-characters

# Docker Compose
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Optional TRC20 USDT payment watcher (mainnet only). Both values are required to enable it.
# Use a TronGrid API key and the merchant's TRON Base58 receiving address.
# TRONGRID_API_KEY=
# TRON_RECEIVE_ADDRESS=
# TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
