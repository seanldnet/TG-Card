# Application
APP_ENV=production
PORT=38647
DATA_DIR=./data
WEB_DIST_DIR=./web/dist

# Database: postgres or sqlite
DB_DRIVER=postgres
DATABASE_URL=postgres://tgcard:change-this-password@127.0.0.1:5432/tgcard?sslmode=disable

# First startup only: if ADMIN_PASSWORD is empty, a strong one-time password is generated and printed to server logs.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=use-at-least-12-characters

# Optional. If omitted, a persistent random key is created in DATA_DIR/jwt-secret.
# JWT_SECRET=replace-with-at-least-32-random-characters

# Optional shared rate limiting / multi-instance coordination support.
# Start Redis first with `docker compose --profile redis up -d redis`, then set
# REDIS_URL=redis://redis:6379/0 and restart the app. For external Redis use rediss://.
# REDIS_URL=

# Docker Compose
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Required for encrypted local and scheduled backups; keep outside DATA_DIR and the repository.
# Generate a high-entropy value (e.g. openssl rand -base64 48) and store it in a password manager.
BACKUP_ENCRYPTION_PASSPHRASE=

